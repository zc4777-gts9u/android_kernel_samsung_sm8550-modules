
# Select kalama configs for samsung board
KALAMA_AUDIO_CONF := $(AUDIO_ROOT)/config/kalamaauto.conf
KALAMA_AUDIO_AUTOCONF := $(AUDIO_ROOT)/config/kalamaautoconf.h

ifeq (y, $(filter y,\
	$(CONFIG_SEC_PLATFORM_B5Q) \
	$(CONFIG_SEC_PLATFORM_E5Q)))
    KALAMA_AUDIO_CONF := $(AUDIO_ROOT)/config/kalama_b5.conf
    KALAMA_AUDIO_AUTOCONF := $(AUDIO_ROOT)/config/kalamaautoconf_b5.h
endif

ifeq (y, $(filter y,\
	$(CONFIG_SEC_PLATFORM_GTS9) \
	$(CONFIG_SEC_PLATFORM_GTS9P) \
	$(CONFIG_SEC_PLATFORM_GTS9U) \
	$(CONFIG_SEC_PLATFORM_GTS9WIFI) \
	$(CONFIG_SEC_PLATFORM_GTS9PWIFI) \
	$(CONFIG_SEC_PLATFORM_GTS9UWIFI)))
    KALAMA_AUDIO_CONF := $(AUDIO_ROOT)/config/kalama_gts9.conf
    KALAMA_AUDIO_AUTOCONF := $(AUDIO_ROOT)/config/kalamaautoconf_gts9.h
endif
